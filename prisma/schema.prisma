generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Conta {
  id           Int      @id @default(autoincrement())
  nome         String
  saldoInicial Decimal  @default(0) @db.Decimal(12, 2)
  criadoEm     DateTime @default(now())

  // Quando o usuário digita o saldo na edição, saldoInicial vira esse valor e
  // só entram no saldo as transações com id maior que transacaoCorteId
  // (lançadas depois). Sem edição: corte 0, todas as transações contam
  saldoDefinidoEm  DateTime?
  transacaoCorteId Int       @default(0)

  // Dono da conta: cada usuário só vê e altera os próprios dados
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  transacao            Transacao[]
  pagamentosContaPagar PagamentoContaPagar[]
  recebimento          RecebimentoContaReceber[]

  transferenciasEnviadas  Transferencia[] @relation("TransferenciaOrigem")
  transferenciasRecebidas Transferencia[] @relation("TransferenciaDestino")

  @@index([usuarioId])
}

model Categoria {
  id   Int           @id @default(autoincrement())
  nome String
  tipo TipoTransacao

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  transacoes Transacao[]

  // O nome só se repete entre usuários diferentes
  @@unique([usuarioId, nome])
}

enum TipoTransacao {
  DESPESA
  RECEITA
}

model Transacao {
  id        Int           @id @default(autoincrement())
  descricao String        @db.VarChar(200)
  valor     Decimal       @db.Decimal(12, 2)
  tipo      TipoTransacao
  data      DateTime      @default(now())
  contaId   Int
  conta     Conta         @relation(fields: [contaId], references: [id])

  categoriaId           Int
  categoria             Categoria @relation(fields: [categoriaId], references: [id])
  pagamentoContaPagarId Int?      @unique
  recebimentoId         Int?      @unique

  recebimentos        RecebimentoContaReceber? @relation(fields: [recebimentoId], references: [id])
  pagamentoContaPagar PagamentoContaPagar?     @relation(fields: [pagamentoContaPagarId], references: [id])

  transferenciaId Int?
  transferencia   Transferencia? @relation(fields: [transferenciaId], references: [id])
}

enum StatusContaPagar {
  PENDENTE
  PARCIALMENTE_PAGA
  PAGA
}

model ContaPagar {
  id         Int                   @id @default(autoincrement())
  descricao  String
  valorTotal Decimal               @db.Decimal(12, 2)
  valorPago  Decimal               @default(0) @db.Decimal(12, 2)
  vencimento DateTime
  status     StatusContaPagar      @default(PENDENTE)
  criadoEm   DateTime              @default(now())
  pagamentos PagamentoContaPagar[]

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model PagamentoContaPagar {
  id    Int      @id @default(autoincrement())
  valor Decimal  @db.Decimal(12, 2)
  data  DateTime @default(now())

  contaPagarId Int
  contaPagar   ContaPagar @relation(fields: [contaPagarId], references: [id])
  contaId      Int
  conta        Conta      @relation(fields: [contaId], references: [id])

  transacao Transacao?
}

enum StatusContaReceber {
  PENDENTE
  PARCIALMENTE_RECEBIDA
  RECEBIDA
}

model ContaReceber {
  id            Int                @id @default(autoincrement())
  descricao     String
  valorTotal    Decimal            @db.Decimal(12, 2)
  valorRecebido Decimal            @default(0) @db.Decimal(12, 2)
  vencimento    DateTime
  status        StatusContaReceber @default(PENDENTE)
  criadoEm      DateTime           @default(now())

  recebimentos RecebimentoContaReceber[]

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model RecebimentoContaReceber {
  id    Int      @id @default(autoincrement())
  valor Decimal  @db.Decimal(12, 2)
  data  DateTime @default(now())

  contaReceberId Int
  contaReceber   ContaReceber @relation(fields: [contaReceberId], references: [id])

  contaId Int
  conta   Conta @relation(fields: [contaId], references: [id])

  transacao Transacao?
}

enum Papel {
  USUARIO
  ADMIN
}

model Usuario {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  senha         String
  papel         Papel          @default(USUARIO)
  // Incrementado ao trocar senha / sair de todos: invalida access tokens antigos
  tokenVersao   Int            @default(0)
  criadoEm      DateTime       @default(now())
  refreshTokens RefreshToken[]

  contas        Conta[]
  categorias    Categoria[]
  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  hash      String    @unique
  expiraEm  DateTime
  usado     Boolean   @default(false) // já foi trocado por um par novo?
  usadoEm   DateTime? // quando foi usado (útil para auditoria)
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Transferencia {
  id        Int      @id @default(autoincrement())
  valor     Decimal  @db.Decimal(12, 2)
  descricao String   @db.VarChar(200)
  data      DateTime @default(now())

  contaOrigemId  Int
  contaOrigem    Conta @relation("TransferenciaOrigem", fields: [contaOrigemId], references: [id])
  contaDestinoId Int
  contaDestino   Conta @relation("TransferenciaDestino", fields: [contaDestinoId], references: [id])

  // Sempre duas: DESPESA na origem e RECEITA no destino
  transacoes Transacao[]
}
