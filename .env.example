# Copie para .env e preencha
DATABASE_URL="postgresql://usuario:senha@localhost:5432/SistemaFinanceiro_DB"

# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SEGREDO=""

# Opcionais
PORT=3000
NODE_ENV=development
# Origens liberadas no CORS (separadas por vírgula). Vazio = CORS desligado
CORS_ORIGENS=
# Número de proxies na frente da API (Nginx, Render...). 0 = nenhum
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
